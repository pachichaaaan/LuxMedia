# Canonical origin used for metadata, sitemap, robots, and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Without it, contact submissions are logged in development and still succeed.
RESEND_API_KEY=

# Where contact submissions are delivered when RESEND_API_KEY is set.
CONTACT_TO_EMAIL=hello@theluxexpo.example

# Optional. Verified sender for Resend. Defaults to Resend's onboarding sender.
CONTACT_FROM_EMAIL=
